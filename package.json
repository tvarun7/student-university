{
  "name": "student-university",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed.js",
    "test": "node --test --test-concurrency=1 server/*.test.js",
    "install:all": "npm install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "bootstrap:admin": "node server/bootstrap-admin.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "connect-pg-simple": "^10.0.0",
    "pg": "^8.16.3",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
