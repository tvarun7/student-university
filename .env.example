PORT=3000
NODE_ENV=development
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-value-at-least-32-characters
# Optional locally. Required for production:
# DATABASE_URL=postgresql://university:CHANGE_ME@localhost:5432/university
# DATABASE_SSL=true
# TRUST_PROXY=1
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
